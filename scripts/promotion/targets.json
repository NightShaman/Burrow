      "repository": "Goblin-Secret-Store",
      "releaseAssets": ["source-snapshot"],
      "dependsOn": ["goblinSecretStore"]
    },
    "burrowSkills": {
      "repository": "Burrow-Skills",
      "releaseAssets": ["source-snapshot"],
      "dependsOn": ["burrowSkills"]
    }
  }
}
