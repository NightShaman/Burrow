    "burrow": {
      "repository": "Burrow",
      "releaseAssets": ["container-image", "source-snapshot"],
      "dependsOn": ["burrowBackend", "burrowUi", "nodeGoblin"]
    },
    "nodeGoblin": {
      "repository": "Node-Goblin",
      "releaseAssets": ["node-goblin-tarball", "sha256"],
