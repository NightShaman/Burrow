{
  "name": "shipstyles",
  "description": "Zero-config runtime styles for UI packages: ship scoped CSS without consumer imports or bundler setup.",
  "version": "1.0.0",
  "homepage": "https://ealush.github.io/shipstyles",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ealush/shipstyles.git"
  },
  "bugs": {
    "url": "https://github.com/ealush/shipstyles/issues"
  },
  "keywords": [
    "CSS-in-JS",
    "component-library",
    "UI-packages",
    "scoped-styles",
    "CSS-delivery",
    "zero-config",
    "SSR",
    "Shadow-DOM",
    "CSP",
    "bundler-agnostic",
    "CSS-variables",
    "atomic-CSS",
    "style",
    "StyleSheet",
    "reusable"
  ],
  "main": "./dist/index.js",
  "devDependencies": {
    "@swc/core": "^1.3.102",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.1.1",
    "semantic-release": "^25.0.9",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup ./src/index.ts --target es5",
    "lint": "eslint --ext .ts ./src",
    "test": "vitest --watch=false",
    "test:acceptance": "npm run build && node --test acceptance/*.test.mjs",
    "test:all": "npm run test && npm run test:acceptance",
    "prepublish": "npm run test && npm run build"
  },
  "tsup": {
    "sourcemap": true,
    "dts": true,
    "clean": true,
    "legacyOutput": true,
    "format": [
      "cjs",
      "esm"
    ]
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
