# INERT TEMPLATE — moving this file to .github/workflows requires explicit activation.
name: Promote public Goblin Kingdom releases
on:
  schedule:
    - cron: '30 5 * * *'
  workflow_dispatch:
permissions: {}
concurrency:
  group: public-promotion
  cancel-in-progress: false
jobs:
  promotion:
    runs-on: ubuntu-latest
    steps:
      - run: echo 'Activation requires the reviewed publisher implementation, public repositories, GitHub App credentials, branch protection, and a successful dry run.' && exit 1
